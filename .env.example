# OpenRouter API Key for Gemini 3.8 Flash model
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3.8-flash

# Case-law search goes through the case-law API (cd caselaw-db && npm start). Default shown.
# CASELAW_API_URL=http://127.0.0.1:8090
# That API reads the database password from PGPASSWORD (not stored in the repo).
