# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info                # debug | info | warn | error

# ── Data source ──────────────────────────────────────────────────────────
# fixture = serve from bundled HTML fixtures (no browser, deterministic, used in tests/CI)
# live    = scrape the real eCourts portal with Playwright (requires `npm i playwright`)
ECOURTS_SOURCE=fixture

# ── Multi-tenant API keys ────────────────────────────────────────────────
# Comma-separated  key:tenantName  pairs. Callers send the key in the x-api-key header.
API_KEYS=demo-key-firm-a:Kamat & Partners,demo-key-firm-b:Rao Legal LLP
# Admin key guards /admin/* (usage stats). Keep this secret.
ADMIN_KEY=demo-admin-key

# ── Cache ────────────────────────────────────────────────────────────────
# Case status changes at most a few times a day, so cache aggressively to avoid
# hammering eCourts (this is what keeps you off their rate-limiter at scale).
CACHE_TTL_MS=21600000          # 6 hours
CACHE_MAX_ENTRIES=5000

# ── Rate limiting (per API key, fixed window) ────────────────────────────
RATE_LIMIT_PER_MIN=30

# ── Live scraper (only used when ECOURTS_SOURCE=live) ─────────────────────
ECOURTS_BASE_URL=https://services.ecourts.gov.in/ecourtindia_v6
SCRAPE_TIMEOUT_MS=30000
SCRAPE_HEADLESS=true
# CAPTCHA strategy: none | manual | twocaptcha
CAPTCHA_STRATEGY=none
TWOCAPTCHA_API_KEY=
